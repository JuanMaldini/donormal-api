# --- PocketBase ---------------------------------------------------------
PB_URL=

# Colecciones. Sin fallback: si falta una, el worker no arranca.
PB_USERS=
PB_TEXTURES=

# --- Cuenta de servicio -------------------------------------------------
# Un registro de la coleccion de usuarios con role="worker".
#
# NO es un token. PocketBase no tiene API keys permanentes: los tokens de
# impersonate no son renovables y vencen en silencio. El worker hace
# auth-with-password y el cliente reautentica solo cuando caduca.
PB_WORKER_EMAIL=
PB_WORKER_PASSWORD=

# En la VPS estas variables NO salen de este archivo: se cargan en el panel de
# Dokploy (Environment). Este archivo existe para correr el worker en local.

# --- Solo para tools/import_new.py (migracion, un solo uso) --------------
# El worker NO lee estas. PB_IMPORT_* es la cuenta REAL de la persona que va a
# ser duena de los assets migrados, no la cuenta de servicio.
# PB_MODELS=
# PB_IMPORT_EMAIL=
# PB_IMPORT_PASSWORD=
