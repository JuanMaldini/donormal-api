# Clothfigurator - Normal Worker
# =============================
# En la VPS estas variables NO salen de este archivo: se cargan en la UI de
# Dokploy (Environment). Este archivo existe para correr el worker en local
# contra una PocketBase de prueba.
#
# Copialo a .env y rellenalo. Sin fallbacks: si falta una, el worker no arranca.
#
# Los nombres de las colecciones NO son variables: viven hardcodeados en
# src/config.py (clothfigurator_users / _models / _textures / _products /
# _links). Son fijos en todas las instancias, asi que como variable solo
# agregaban una forma mas de configurar mal el worker.

# --- PocketBase ---------------------------------------------------------
PB_URL=https://pocketbase.vp3dserver.online

# --- Cuenta de servicio -------------------------------------------------
# Un registro de clothfigurator_users con role="worker".
#
# NO es un token. PocketBase no tiene API keys permanentes: los tokens de
# impersonate no son renovables y vencen en silencio. El worker hace
# auth-with-password y el cliente refresca solo.
PB_WORKER_EMAIL=unreal@vanishingpoint3d.com
PB_WORKER_PASSWORD=
